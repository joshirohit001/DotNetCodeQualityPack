# Created by .NET Code Quality Pack. Formatting basics plus the code quality rules block at the end.
# Edit freely, or open this file in Visual Studio to use the visual .editorconfig designer.
root = true

[*]
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,xml,config,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Braces and expressions
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
dotnet_style_prefer_conditional_expression_over_assignment = true:silent

# 'var'
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent

# Modern language features (only suggested where the project's C# version supports them)
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

# Code quality
dotnet_style_readonly_field = true:suggestion
dotnet_code_quality_unused_parameters = all:suggestion
# Unused private members
dotnet_diagnostic.IDE0051.severity = warning
# Unused using directives
dotnet_diagnostic.IDE0005.severity = suggestion

[*Tests.cs]
# Test method names like Method_Scenario_Expected are fine
dotnet_diagnostic.CA1707.severity = none
