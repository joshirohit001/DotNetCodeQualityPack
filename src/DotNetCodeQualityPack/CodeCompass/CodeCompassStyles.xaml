<!--
    Shared look of the Code Compass windows (chat and AI provider settings). Colours are DynamicResource "CC.*" keys that
    ThemeManager sets on each window, so a theme switch restyles everything live.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <FontFamily x:Key="CC.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ===== Buttons ===== -->
        <Style x:Key="CC.ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.GhostButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Foreground" Value="{DynamicResource CC.SubtleText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CC.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.IconButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="FontFamily" Value="{StaticResource CC.IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource CC.SubtleText}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CC.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.OutlineButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="Background" Value="{DynamicResource CC.SurfaceAlt}" />
            <Setter Property="Height" Value="28" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CC.Hover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.PrimaryButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource CC.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource CC.AccentText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Height" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CC.AccentHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.DangerButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource CC.ErrorSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource CC.Error}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Height" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CC.Error}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.ChipButton" TargetType="Button" BasedOn="{StaticResource CC.ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource CC.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                    <Setter Property="Background" Value="{DynamicResource CC.AccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Segmented tabs ===== -->
        <Style x:Key="CC.Tab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CC.SubtleText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,5" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.Surface}" />
                                <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.Option" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="14" Padding="10,4" BorderThickness="1"
                                BorderBrush="{DynamicResource CC.Border}" Background="{DynamicResource CC.SurfaceAlt}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style x:Key="CC.ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.ComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="Background" Value="{DynamicResource CC.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CC.ComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                                Background="{DynamicResource CC.SurfaceAlt}" BorderBrush="{DynamicResource CC.Border}">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                                       Foreground="{DynamicResource CC.SubtleText}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" VerticalOffset="2">
                                <Border CornerRadius="6" BorderThickness="1" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CC.Surface}" BorderBrush="{DynamicResource CC.Border}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Text boxes ===== -->
        <Style x:Key="CC.TextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource CC.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource CC.Accent}" />
            <Setter Property="Background" Value="{DynamicResource CC.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                           Foreground="{DynamicResource CC.SubtleText}" IsHitTestVisible="False" Visibility="Collapsed"
                                           TextWrapping="Wrap" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ===== Slim scroll bars ===== -->
        <Style x:Key="CC.ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource CC.Border}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CC.SubtleText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CC.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource CC.ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CC.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CC.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- API keys: masked, never shown again after saving. -->
        <Style x:Key="CC.PasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource CC.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource CC.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource CC.Accent}" />
            <Setter Property="Background" Value="{DynamicResource CC.SurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CC.Border}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CC.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
