<UserControl x:Class="DotNetCodeQualityPack.CodeCompass.AiProvidersControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource CC.Text}"
             Background="{DynamicResource CC.Bg}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DotNetCodeQualityPack;component/CodeCompass/CodeCompassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="18,14,18,10" Background="{DynamicResource CC.Surface}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CC.Border}">
            <StackPanel>
                <TextBlock Text="AI providers" FontSize="17" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource CC.SubtleText}"
                           Text="Choose the AI services Code Compass and Team Rules may use, with your own API key, model names and API URL. Settings are saved for your Windows account only; API keys are encrypted and never shown again." />
            </StackPanel>
        </Border>

        <!-- One card per provider (built in code) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CardsPanel" Margin="18,12,18,6" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="18,10" Background="{DynamicResource CC.Surface}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CC.Border}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource CC.GhostButton}" Content="Cancel" Click="OnCancel" Margin="0,0,6,0" IsCancel="True" />
                    <Button Style="{StaticResource CC.PrimaryButton}" Content="Save" Click="OnSave" IsDefault="True" />
                </StackPanel>
                <TextBlock x:Name="FooterText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource CC.SubtleText}"
                           Text="Requests go straight from Visual Studio to the provider you choose. With OpenAI or Anthropic your code leaves this PC; Ollama on localhost keeps it here." />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
