<UserControl x:Class="DotNetCodeQualityPack.CodeCompass.CodeCompassControl"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="460"
             x:Name="Root"
             AllowDrop="True"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13"
             Foreground="{DynamicResource CC.Text}"
             Background="{DynamicResource CC.Bg}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DotNetCodeQualityPack;component/CodeCompass/CodeCompassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CC.Border}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ZoomButton" Style="{StaticResource CC.GhostButton}" Content="100%"
                                ToolTip="Ctrl + mouse wheel to zoom, Ctrl+0 to reset. Click to reset." Click="OnZoomReset" />
                        <Button x:Name="SettingsButton" Style="{StaticResource CC.IconButton}" Content="&#xE713;"
                                ToolTip="Settings" Click="OnToggleSettings" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource CC.Accent}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE7B7;" FontFamily="{StaticResource CC.IconFont}" FontSize="14"
                                       Foreground="{DynamicResource CC.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Code Compass" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CC.SurfaceAlt}" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ChatTab" Style="{StaticResource CC.Tab}" GroupName="CCTabs" IsChecked="True" Checked="OnTabChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource CC.IconFont}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Chat" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ReviewTab" Style="{StaticResource CC.Tab}" GroupName="CCTabs" Checked="OnTabChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource CC.IconFont}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Code Review" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="ModelCombo" Grid.Column="1" Style="{StaticResource CC.ComboBox}" Margin="8,0,6,0"
                              MinWidth="120" ToolTip="Model used for chat and code review" SelectionChanged="OnModelChanged" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" Style="{StaticResource CC.ComboBox}" Width="128"
                              ToolTip="Window theme" SelectionChanged="OnThemeChanged" />
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Settings ===== -->
        <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Padding="12,10"
                Background="{DynamicResource CC.Surface}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CC.Border}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="AI providers" VerticalAlignment="Center" Margin="0,0,10,6" />
                <TextBlock x:Name="ProvidersSummary" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,6"
                           Foreground="{DynamicResource CC.SubtleText}" />
                <Button Grid.Column="2" Style="{StaticResource CC.PrimaryButton}" Content="Configure…" Click="OnConfigureProviders" Margin="0,0,0,6"
                        ToolTip="OpenAI, Anthropic or Ollama: your own API URL, API key and model names" />

                <TextBlock Grid.Row="1" Text="Rules" VerticalAlignment="Center" Margin="0,0,10,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,6"
                           Foreground="{DynamicResource CC.SubtleText}"
                           Text="The rules file and Copilot instruction files are set in Team Rules." />
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CC.OutlineButton}" Content="Open Team Rules" Click="OnOpenTeamRules" Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Text="Chat memory" VerticalAlignment="Center" Margin="0,0,10,6" />
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="HistoryCountBox" Style="{StaticResource CC.TextBox}" Width="60" />
                    <TextBlock Text="earlier messages sent with each question" Foreground="{DynamicResource CC.SubtleText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Style="{StaticResource CC.GhostButton}" Content="Open chats folder" Click="OnOpenDataFolder" Margin="0,0,6,0" />
                    <Button Style="{StaticResource CC.PrimaryButton}" Content="Save &amp; reload models" Click="OnSaveSettings" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Content (zoomable) ===== -->
        <Grid x:Name="ContentHost" Grid.Row="2">

            <!-- ===================== CHAT ===================== -->
            <Grid x:Name="ChatView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="10,8,10,4" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CC.IconButton}" Content="&#xE710;" ToolTip="New chat" Click="OnNewChat" />
                        <Button Style="{StaticResource CC.IconButton}" Content="&#xE74D;" ToolTip="Delete this chat" Click="OnDeleteChat" />
                    </StackPanel>
                    <ComboBox x:Name="ConversationCombo" Style="{StaticResource CC.ComboBox}" DisplayMemberPath="DisplayTitle"
                              ToolTip="Earlier chats for this solution" SelectionChanged="OnConversationChanged" />
                </DockPanel>

                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="10,4,10,8">
                    <StackPanel x:Name="MessagesPanel" />
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyChatPanel" Grid.Row="1" VerticalAlignment="Center" Margin="24,0" MaxWidth="420">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource CC.AccentSoft}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7B7;" FontFamily="{StaticResource CC.IconFont}" FontSize="22" Foreground="{DynamicResource CC.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Ask anything about your code" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Paste screenshots (Ctrl+V), attach files, or drop them here. The chat remembers earlier messages."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource CC.SubtleText}" Margin="0,0,0,16" />
                    <Button Style="{StaticResource CC.ChipButton}" Tag="explain" Click="OnSuggestion">
                        <TextBlock><Run FontFamily="{StaticResource CC.IconFont}" Text="&#xE946;" /><Run Text="   Explain the selected code" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource CC.ChipButton}" Tag="tests" Click="OnSuggestion">
                        <TextBlock><Run FontFamily="{StaticResource CC.IconFont}" Text="&#xE9D5;" /><Run Text="   Write unit tests for the selection" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource CC.ChipButton}" Tag="bugs" Click="OnSuggestion">
                        <TextBlock><Run FontFamily="{StaticResource CC.IconFont}" Text="&#xEBE8;" /><Run Text="   Find bugs in the open file" /></TextBlock>
                    </Button>
                </StackPanel>

                <!-- Composer -->
                <Border Grid.Row="2" Margin="10,4,10,10" Style="{StaticResource CC.Card}" Padding="8">
                    <StackPanel>
                        <ItemsControl x:Name="AttachmentsList" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="ComposerNotice" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,0,0,6" FontSize="12"
                                   Foreground="{DynamicResource CC.Warning}" />
                        <TextBox x:Name="InputBox" Style="{StaticResource CC.TextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="200" VerticalScrollBarVisibility="Auto" BorderBrush="Transparent" Background="Transparent"
                                 Tag="Ask Code Compass…  (Enter to send, Shift+Enter for a new line)"
                                 PreviewKeyDown="OnInputPreviewKeyDown" />
                        <DockPanel Margin="0,6,0,0" LastChildFill="False">
                            <Button x:Name="AttachButton" Style="{StaticResource CC.IconButton}" Content="&#xE723;" ToolTip="Attach files or images" Click="OnAttach" />
                            <Button Style="{StaticResource CC.IconButton}" Content="&#xE77F;" ToolTip="Paste image, files or text from the clipboard" Click="OnPasteClipboard" />
                            <Button Style="{StaticResource CC.IconButton}" Content="&#xE943;" ToolTip="Attach the code selected in the editor" Click="OnAttachSelection" />
                            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource CC.PrimaryButton}" Click="OnSend" ToolTip="Send (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Send" Margin="0,0,6,0" />
                                    <TextBlock Text="&#xE724;" FontFamily="{StaticResource CC.IconFont}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" DockPanel.Dock="Right" Style="{StaticResource CC.DangerButton}" Visibility="Collapsed"
                                    Click="OnStop" ToolTip="Stop generating">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource CC.IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== CODE REVIEW ===================== -->
            <Grid x:Name="ReviewView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="10,10,10,6" Style="{StaticResource CC.Card}">
                    <StackPanel>
                        <TextBlock Text="What should I review?" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <RadioButton x:Name="SourceSelection" Style="{StaticResource CC.Option}" GroupName="CCSource" Content="Selection" IsChecked="True" Checked="OnSourceChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="SourceFile" Style="{StaticResource CC.Option}" GroupName="CCSource" Content="Open file" Checked="OnSourceChanged" Margin="0,0,6,6" />
                            <RadioButton x:Name="SourcePaste" Style="{StaticResource CC.Option}" GroupName="CCSource" Content="Paste code" Checked="OnSourceChanged" Margin="0,0,6,6" />
                        </WrapPanel>
                        <TextBox x:Name="PasteCodeBox" Style="{StaticResource CC.TextBox}" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Height="150" Margin="0,2,0,8"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Tag="Paste C# code here (Ctrl+V)" />
                        <DockPanel LastChildFill="True" Margin="0,2,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="StopReviewButton" Style="{StaticResource CC.DangerButton}" Content="Stop" Visibility="Collapsed" Click="OnStopReview" Margin="0,0,6,0" />
                                <Button x:Name="ReviewButton" Style="{StaticResource CC.PrimaryButton}" Click="OnReview">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource CC.IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Review code" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <CheckBox x:Name="IncludeImprovedCheck" Content="Include fully improved code" IsChecked="True" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Style="{StaticResource CC.GhostButton}" Content="Team Rules…" Click="OnOpenTeamRules" ToolTip="Choose the rules file and Copilot instruction files" />
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource CC.IconFont}" Foreground="{DynamicResource CC.SubtleText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="RulesLabel" Text="Rules: loading…" Foreground="{DynamicResource CC.SubtleText}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar x:Name="ReviewProgress" IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="Collapsed"
                                     Foreground="{DynamicResource CC.Accent}" Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="ReviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,10">
                    <StackPanel x:Name="ReviewResultsPanel" />
                </ScrollViewer>

                <StackPanel x:Name="ReviewEmptyPanel" Grid.Row="1" VerticalAlignment="Center" Margin="24,0" MaxWidth="400">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource CC.IconFont}" FontSize="30" Foreground="{DynamicResource CC.Accent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Review against your team rules" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource CC.SubtleText}"
                               Text="Select code in the editor (or pick Open file) and click Review code. Each finding comes with the rule it breaks and a corrected code snippet you can copy or apply." />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Padding="10,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CC.Border}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource CC.SubtleText}" />
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource CC.SubtleText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource CC.SubtleText}" TextTrimming="CharacterEllipsis" Text="Ready" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
